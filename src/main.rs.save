enum Token {
    Command(String),
    Arg(String),
    Semicolon,
    Pipe,
    And,
}

enum Status {
    Word(char),
    Operation(char),
    Null,
}

struct Tokens {
    input: String(),
    tokens: Vec<Token>,
}

impl Tokens {
    fn new(input: &str) -> Tokens {
